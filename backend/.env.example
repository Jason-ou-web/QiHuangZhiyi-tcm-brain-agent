# === 必填环境变量 ===
# DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-api-key-here

# JWT Secret（用于签名 Token，生成命令: openssl rand -hex 32）
# 注意：不要与任何已泄露的密钥相同
JWT_SECRET=your-jwt-secret-here

# === 可选环境变量（以下均为默认值） ===

# 服务端口
SERVER_PORT=8080

# DeepSeek API 配置
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qdrant 向量数据库
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=tcm_knowledge

# Redis 缓存
REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# Embedding 服务（BGE-M3，需独立部署）
EMBEDDING_URL=http://localhost:8081/embed

# Reranker 服务（BGE-Reranker-v2，需独立部署）
RERANKER_URL=http://localhost:8082/rerank

# CORS 允许的前端来源（多来源逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000
